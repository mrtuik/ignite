{
  "expo": {
    "name": "Ignite",
    "slug": "ignite",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F7F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.coffeewithtuik.ignite"
    },
    "android": {
      "package": "com.coffeewithtuik.ignite",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
